{"papers":[{"id":"official:84d48562d0d078c1","title":"DALL·E 2 pre-training mitigations","url":"https://openai.com/index/dall-e-2-pre-training-mitigations","paper_url":"","alternate_urls":["https://openai.com/index/dall-e-2-pre-training-mitigations"],"alternate_titles":["DALL·E 2 pre-training mitigations"],"published":"2022-06-28","authors":["OpenAI"],"abstract":"In order to share the magic of DALL·E 2 with a broad audience, we needed to reduce the risks associated with powerful image generation models. To this end, we put various guardrails in place to prevent generated images from violating our content policy.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/dall-e-2-pre-training-mitigations","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["image generation","pre-training"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"official:88849acbf0967d68","title":"Learning to play Minecraft with Video PreTraining","url":"https://openai.com/index/vpt","paper_url":"","alternate_urls":["https://openai.com/index/vpt"],"alternate_titles":["Learning to play Minecraft with Video PreTraining"],"published":"2022-06-23","authors":["OpenAI"],"abstract":"We trained a neural network to play Minecraft by Video PreTraining (VPT) on a massive unlabeled video dataset of human Minecraft play, while using only a small amount of labeled contractor data. With fine-tuning, our model can learn to craft diamond tools, a task that usually takes proficient humans over 20 minutes (24,000 actions). Our model uses the native human interface of keypresses and mouse movements, making it quite general, and represents a step towards general computer-using agents.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/vpt","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["computer-using agents","pretraining","fine-tuning","neural network","neural"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"official:8be7a97a6d6b31cc","title":"Evolution through large models","url":"https://openai.com/index/evolution-through-large-models","paper_url":"","alternate_urls":["https://openai.com/index/evolution-through-large-models"],"alternate_titles":["Evolution through large models"],"published":"2022-06-17","authors":["OpenAI"],"abstract":"","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_typ