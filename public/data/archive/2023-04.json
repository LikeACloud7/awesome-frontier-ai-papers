":["High-Throughput Vector Similarity Search in Knowledge Graphs"],"published":"2023-04-24","authors":["Jason Mohoney","Anil Pacaci","Shihabur Rahman Chowdhury","Ali Mousavi","Ihab F. Ilyas","Umar Farooq Minhas","Jeffrey Pound","and Theodoros Rekatsinas"],"abstract":"There is an increasing adoption of machine learning for encoding data into vectors to serve online recommendation and search use cases. As a result, recent data management systems propose augmenting query processing with online vector similarity search. In this work, we explore vector similarity search in the context of Knowledge Graphs (KGs). Motivated by the tasks of finding related KG queries and entities for past KG query workloads, we focus...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/high-throughput-vector","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["machine learning"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:wkio82hghnjqbd016leu0ms2","title":"FaceLit: Neural 3D Relightable Faces","url":"https://machinelearning.apple.com/research/neural-3d-relightable","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/neural-3d-relightable"],"alternate_titles":["FaceLit: Neural 3D Relightable Faces"],"published":"2023-04-17","authors":["Anurag Ranjan","Kwang Moo Yi","Jen-Hao Rick Chang","Oncel Tuzel"],"abstract":"We propose a generative framework, FaceLit, capable of generating a 3D face that can be rendered at various user-defined lighting conditions and views, learned purely from 2D images in-the-wild without any manual annotation. Unlike existing works that require careful capture setup or human labor, we rely on off-the-shelf pose and illumination estimators. With these estimates, we incorporate the Phong reflectance model in the neural volume...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/neural-3d-relightable","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["generative","neural"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:f6nnwa8qhg68byz2zwli61tt","title":"Angler: Helping Machine Translation Practitioners Prioritize Model Improvements","url":"https://machinelearning.apple.com/research/helping-machine-translation","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/helping-machine-translation"],"alternate_titles":["Angler: Helping Machine Translation Practitioners Prioritize Model Improvements"],"published":"2023-04-13","authors":["Samantha Robertson","Zijie J. Wang","Dominik Moritz","Mary Beth Kery","Fred Hohman"],"abstract":"=Authors contributed equally","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/helping-machine-translation","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":[],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:w2kes292fwqms7ao7kq86c7s","title":"Text is All You Need: Personalizing ASR Models using Controllable Speech Synthesis","url":"https://machinelearning.apple.com/research/personalizing-asr-models","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/personalizing-asr-models"],"alternate_titles":["Text is All You Need: Personalizing ASR Models using Controllable Speech Synthesis"],"published":"2023-04-12","authors":["Karren Yang","Ting-Yao Hu","Jen-Hao Rick Chang","Hema Swetha Koppula","Oncel Tuzel"],"abstract":"Adapting generic speech recognition models to specific individuals is a challenging problem due to the