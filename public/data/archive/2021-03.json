.com/research"},{"id":"apple:n2mttpeh6ujep23t7dbkqk6p","title":"Generating Natural Questions from Images for Multimodal Assistants","url":"https://machinelearning.apple.com/research/generating-natural-questions","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/generating-natural-questions"],"alternate_titles":["Generating Natural Questions from Images for Multimodal Assistants"],"published":"2021-03-08","authors":["Alkesh Patel","Akanksha Bindal","Hadas Kotek","Christopher Klein","Jason Williams"],"abstract":"Generating natural, diverse, and meaningful questions from images is an essential task for multimodal assistants as it confirms whether they have understood the object and scene in the images properly. The research in visual question answering (VQA) and visual question generation (VQG) is a great step. However, this research does not capture questions that a visually-abled person would ask multimodal assistants. Recently published datasets such...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/generating-natural-questions","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["multimodal"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"official:1b44837ccce60bcc","title":"Multimodal neurons in artificial neural networks","url":"https://openai.com/index/multimodal-neurons","paper_url":"","alternate_urls":["https://openai.com/index/multimodal-neurons"],"alternate_titles":["Multimodal neurons in artificial neural networks"],"published":"2021-03-04","authors":["OpenAI"],"abstract":"We’ve discovered neurons in CLIP that respond to the same concept whether presented literally, symbolically, or conceptually. This may explain CLIP’s accuracy in classifying surprising visual renditions of concepts, and is also an important step toward understanding the associations and biases that CLIP and similar models learn.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/multimodal-neurons","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["multimodal","neural networks","neural"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"apple:u3lxszkuaykhl20miha16yzj","title":"Set Distribution Networks: a Generative Model for Sets of Images","url":"https://machinelearning.apple.com/research/set-distribution-networks","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/