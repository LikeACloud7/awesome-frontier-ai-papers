{"papers":[{"id":"official:19fa0e0e92c348e8","title":"Image GPT","url":"https://openai.com/index/image-gpt","paper_url":"","alternate_urls":["https://openai.com/index/image-gpt"],"alternate_titles":["Image GPT"],"published":"2020-06-17","authors":["OpenAI"],"abstract":"We find that, just as a large transformer model trained on language can generate coherent text, the same exact model trained on pixel sequences can generate coherent image completions and samples. By establishing a correlation between sample quality and image classification accuracy, we show that our best generative model also contains features competitive with top convolutional nets in the unsupervised setting.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/image-gpt","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["GPT","transformer","generative model","transformer model","generative"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"apple:jrju0mybiue06wdcz8mk3hit","title":"A Generative Model for Joint Natural Language Understanding and Generation","url":"https://machinelearning.apple.com/research/a-generative-model-joint-natural-language-understanding-generation","paper_url":"","alternate_urls":["https://machinelearnin