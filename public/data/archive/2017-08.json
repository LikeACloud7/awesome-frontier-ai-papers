{"papers":[{"id":"official:d515a2cbf6298c0c","title":"OpenAI Baselines: ACKTR & A2C","url":"https://openai.com/index/openai-baselines-acktr-a2c","paper_url":"","alternate_urls":["https://openai.com/index/openai-baselines-acktr-a2c"],"alternate_titles":["OpenAI Baselines: ACKTR & A2C"],"published":"2017-08-18","authors":["OpenAI"],"abstract":"We’re releasing two new OpenAI Baselines implementations: ACKTR and A2C. A2C is a synchronous, deterministic variant of Asynchronous Advantage Actor Critic (A3C) which we’ve found gives equal performance. ACKTR is a more sample-efficient reinforcement learning algorithm than TRPO and A2C, and requires only slightly more computation than A2C per update.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/openai-baselines-acktr-a2c","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["reinforcement learning"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"official:610a6a47ba5f57f1","title":"More on Dota 2","url":"https://openai.com/index/more-on-dota-2","paper_url":"","alternate_urls":["https://openai.com/index/more-on-dota-2"],"alternate_titles":["More on Dota 2"],"published":"2017-08-16","authors":["OpenAI"],"abstract":"Our Dota 2 result shows that self-play can catapult the performance of machine learning systems from far below human level to superhuman, given sufficient compute. In the span of a month, our system went from barely matching a high-ranked player to beating the top pros and has continued to improve since then. Supervised deep learning systems can only be as good as their training datasets, but in self-play systems, the available data improves automatically as the agent gets better.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/more-on-dota-2","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["agent","machine learning","deep learning"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"official:b5befa060cd6500d","title":"Dota 2","url":"https://openai.com/index/dota-2","paper_url":"","alternate_urls":["https://openai.com/index/dota-2"],"alternate_titles":["Dota 2"],"published":"2017-08-11","authors":["OpenAI"],"abstract":"We’ve created a bot which beats the world’s top professionals at 1v1 matches of Dota 2 under standard tournament rules. The bot learned the game from scratch by self-play, and does not use imitation learning or tree search. This is a step towards building AI systems which accomplish well-defined goals in messy, complicated situations involving real humans.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/dota-2","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["AI systems","AI"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"official:006de1a092aadb28","title":"Gathering human feedback","url":"https://openai.com/index/gathering-human-feedback","paper_url":"","alternate_urls":["https://openai.com/index/gathering-human-feedback"],"alternate_titles":["Gathering human feedback"],"published":"2017-08-03","authors":["OpenAI"],"abstract":"RL-Teacher is an open-source implementation of our interface to train AIs via occasional human feedback rather than hand-crafted reward functions. The underlying technique was developed as a step towards safe AI systems, but also applies to reinforcement learning problems with rewards that are hard to specify.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/gathering-human-feedback","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["reinforcement learning","AI systems","AI"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"}]}
