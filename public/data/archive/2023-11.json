how...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/transformers-learn","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["large language models","language models","transformer","reasoning","transformer models"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:pyrtivu3donqe3kfdh2tnyzx","title":"TiC-CLIP: Continual Training of CLIP Models","url":"https://machinelearning.apple.com/research/tic-clip-v2","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/tic-clip-v2","https://machinelearning.apple.com/research/tic-clip"],"alternate_titles":["TiC-CLIP: Continual Training of CLIP Models"],"published":"2023-11-30","authors":["Saurabh Garg","Hadi Pour Ansari","Mehrdad Farajtabar","Sachin Mehta","Raviteja Vemulapalli","Oncel Tuzel","Vaishaal Shankar","Fartash Faghri"],"abstract":"Keeping large foundation models up to date on latest data is inherently expensive. To avoid the prohibitive costs of constantly retraining, it is imperative to continually train these models. This problem is exacerbated by the lack of any large scale continual learning benchmarks or baselines. We introduce t