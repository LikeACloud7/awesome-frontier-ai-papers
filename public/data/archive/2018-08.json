{"papers":[{"id":"official:e8762c070090f55f","title":"The International 2018: Results","url":"https://openai.com/index/the-international-2018-results","paper_url":"","alternate_urls":["https://openai.com/index/the-international-2018-results"],"alternate_titles":["The International 2018: Results"],"published":"2018-08-23","authors":["OpenAI"],"abstract":"OpenAI Five lost two games against top Dota 2 players at The International in Vancouver this week, maintaining a good chance of winning for the first 20–35 minutes of both games.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/the-international-2018-results","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":[],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"official:99ea636203dcee69","title":"Large-scale study of curiosity-driven learning","url":"https://openai.com/index/large-scale-study-of-curiosity-driven-learning","paper_url":"","alternate_urls":["https://openai.com/index/large-scale-study-of-curiosity-driven-learning","https://arxiv.org/abs/1808.04355"],"alternate_titles":["Large-scale study of curiosity-driven learning","Large-Scale Study of Curiosity-Driven Learning"],"published":"2018-08-13","authors":["OpenAI","Yuri Burda"],"abstra