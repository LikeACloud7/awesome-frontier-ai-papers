arch_source":"https://machinelearning.apple.com/research"},{"id":"apple:jdzbnsx95yt57tjl3ov7g4ga","title":"GAUDI: A Neural Architect for Immersive 3D Scene Generation","url":"https://machinelearning.apple.com/research/gaudi","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/gaudi"],"alternate_titles":["GAUDI: A Neural Architect for Immersive 3D Scene Generation"],"published":"2022-09-27","authors":["Miguel Angel Bautista","Pengsheng Guo","Samira Abnar","Walter Talbott","Alexander Toshev","Zhuoyuan Chen","Laurent Dinh","Shuangfei Zhai","Hanlin Goh","Daniel Ulbricht","Afshin Dehghan","Josh Susskind"],"abstract":"We introduce GAUDI, a generative model capable of capturing the distribution of complex and realistic 3D scenes that can be rendered immersively from a moving camera. We tackle this challenging problem with a scalable yet powerful approach, where we first optimize a latent representation that disentangles radiance fields and camera poses. This latent representation is then used to learn a generative model that enables both unconditional and...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/gaudi","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["generative model","generative","neural"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"official:a8926d9b477d61c1","title":"Introducing Whisper","url":"https://openai.com/index/whisper","paper_url":"","alternate_urls":["https://openai.com/index/whisper"],"alternate_titles":["Introducing Whisper"],"published":"2022-09-21","authors":["OpenAI"],"abstract":"We’ve trained and are open-sourcing a neural net called Whisper that approaches human level robustness and accuracy on English speech recognition.","companies":["OpenAI"],"matched_orgs":["OpenAI"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"research_post","doi":"","openalex_id":"","cited_by_count":0,"quality_score":56,"matched_keywords":["Research"],"author_affiliations":["OpenAI"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"},"evidence":[{"source":"official_publication_page","url":"https://openai.com/index/whisper","labs":["OpenAI"],"signals":{"company_match_source":"official RSS feed https://openai.com/news/rss.xml"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://openai.com/news/rss.xml","matched_terms":["speech recognition","neural"],"concept_ids":[],"work_type":"research_post"},"ai_research_source":"https://openai.com/news/rss.xml"},{"id":"apple:k1v2nfpok8f8mgcgmbrbmgvk","title":"Providing Insights for Open-Response Surveys via End-to-End Context-Aware Clustering","url":"https://machinelearning.apple.com/research/open-response-surveys","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/open-response-surveys"],"alternate_titles":["Providing Insights for Open-Response Surveys via End-to-End Context-Aware Clustering"],"published":"2022-09-21","authors":["Soheil Esmaeilzadeh","Brian Williams","Davood Shamsi","Onar Vikingstad"],"abstract":"Teachers often conduct surveys in order to collect data from a predefined group of students to gain insights into topics of interest. When analyzing surveys with open-ended textual responses, it is extremely time-consuming, labor-intensive, and difficult to manually process all the responses into an insightful and comprehensive report. In the analysis step, traditionally, the teacher has to read each of the responses and decide on how to group...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/open-response-surveys","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":[],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:ryaq7ondywt3v0oe65kvhkim","title":"RGB-X Classification for Electronics Sorting","url":"https://machinelearning.apple.com/research/rgb-x-classification","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/rgb-x-classification"],"alternate_titles":["RGB-X Classification for Electronics Sorting"],"published":"2022-09-14","authors":["FNU Abhimanyu","Tejas Zodage","Umesh Thillaivasan","Xinyue Lai","Rahul Chakwate","Javier Santillan","Emma Oti","Ming Zhao","Ralph Boirum Howie Choset","Matthew Travers"],"abstract":"Effectively disassembling and recovering materials from waste electrical and electronic equipment (WEEE) is a critical step in moving global supply chains from carbon-intensive, mined materials to recycled and renewable ones. Conventional recycling processes rely on shredding and sorting waste streams, but for WEEE, which is comprised of numerous dissimilar materials, we explore targeted disassembly of numerous objects for improved material...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/rgb-x-classification","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":[],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:g2fw9lycl7kiycppi14m8bo4","title":"Layer-Wise Data-Free CNN Compression","url":"https://machinelearning.apple.com/research/layer-wise-data-free-cnn-compression","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/layer-wise-data-free-cnn-compression"],"alternate_titles":["Layer-Wise Data-Free CNN Compression"],"published":"2022-09-14","authors":["Maxwell Horton","Yanzi Jin","Ali Farhadi","Mohammad Rastegari"],"abstract":"We present an efficient method for compressing a trained neural network without using any data. Our data-free method requires 14x-450x fewer FLOPs than comparable state-of-the-art methods. We break the problem of data-free network compression into a number of independent layer-wise compressions. We show how to efficiently generate layer-wise training data, and how to precondition the network to maintain accuracy during layer-wise compression. We...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/layer-wise-data-free-cnn-compression","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["neural network","neural"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:huqjiu59y9gfv4ajddoepybw","title":"Multi-objective Hyper-parameter Optimization of Behavioral Song Embeddings","url":"https://machinelearning.apple.com/research/multi-objective-hyper-parameter","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/multi-objective-hyper-parameter"],"alternate_titles":["Multi-objective Hyper-parameter Optimization of Behavioral Song Embeddings"],"published":"2022-09-06","authors":["Massimo Quadrana","Antoine Larreche-Mouly","Matthias Mauch"],"abstract":"Song embeddings are a key component of most music recommendation engines. In this work, we study the hyper-parameter optimization of behavioral song embeddings based on Word2Vec on a selection of downstream tasks, namely next-song recommendation, false neighbor rejection, and artist and genre clustering. We present new optimization objectives and metrics to monitor the effects of hyper-parameter optimization. We show that single-objective...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/multi-objective-hyper-parameter","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":[],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:v888iv2c9no4qfudfd0la50n","title":"Mel Spectrogram Inversion with Stable Pitch","url":"https://machinelearning.apple.com/research/mel-spectrogram","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/mel-spectrogram"],"alternate_titles":["Mel Spectrogram Inversion with Stable Pitch"],"published":"2022-09-06","authors":["Bruno Di Giorgi","Mark Levy","Richard Sharp"],"abstract":"Vocoders are models capable of transforming a low-dimensional spectral representation of an audio signal, typically the mel spectrogram, to a waveform. Modern speech generation pipelines use a vocoder as their final component. Recent vocoder models developed for speech achieve a high degree of realism, such that it is natural to wonder how they would perform on music signals.","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/mel-spectrogram","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":[],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:pt97kq1k61205fvut1af6617","title":"ASpanFormer: Detector-Free Image Matching with Adaptive Span Transformer","url":"https://machinelearning.apple.com/research/detector-free-image","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/detector-free-image"],"alternate_titles":["ASpanFormer: Detector-Free Image Matching with Adaptive Span Transformer"],"published":"2022-09-06","authors":["Hongkai Chen","Zixin Luo","Lei Zhou","Yurun Tian","Mingmin Zhen","Tian Fang","David Mckinnon","Yanghai Tsin","Lon