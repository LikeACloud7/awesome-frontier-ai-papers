i_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:q3nif66jwb2i2zbxhsgkq1vg","title":"Managing ML Pipelines: Feature Stores and the Coming Wave of Embedding Ecosystems","url":"https://machinelearning.apple.com/research/managing-ml-pipelines","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/managing-ml-pipelines"],"alternate_titles":["Managing ML Pipelines: Feature Stores and the Coming Wave of Embedding Ecosystems"],"published":"2021-08-16","authors":["Laurel Orr","Atindriyo Sanyal","Xiao Ling","Karan Goel","Megan Leszczynski"],"abstract":"This paper was accepted at the Tutorial Session at 47th International Conference on Very Large Data Bases.","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/managing-ml-pipelines","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["embedding"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:w532yx9rvsdn0xouci16ydva","title":"Subject-Aware Contrastive Learning for Biosignals","url":"https://machinelearning.apple.com/research/subject-aware-contrastive-learning","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/subject-aware-contrastive-learning"],"alternate_titles":["Subject-Aware Contrastive Learning for Biosignals"],"published":"2021-08-06","authors":["Joseph Y. Cheng","Hanlin Goh","Kaan Dogrusoz","Oncel Tuzel","Erdrin Azemi"],"abstract":"Datasets for biosignals, such as electroencephalogram (EEG) and electrocardiogram (ECG), often have noisy labels and have limited number of subjects (<100). To handle these challenges, we propose a self-supervised approach based on contrastive learning to model biosignals with a reduced reliance on labeled data and with fewer subjects. In this regime of limited labels and subjects, intersubject variability negatively impacts model performance....","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/subject-aware-contrastive-learning","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["self-supervised"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:mbpgtzxc7k9n4aabevfi3e0e","title":"Online Automatic Speech Recognition With Listen, Attend and Spell Model","url":"https://machinelearning.apple.com/research/online-automatic-speech-recognition","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/online-automatic-speech-recognition"],"alternate_titles":["Online Automatic Speech Recognition With Listen, Attend and Spell Model"],"published":"2021-08-06","authors":["Roger Hsiao","Dogan Can","Tim Ng","Ruchir Travadi","Arnab Ghoshal"],"abstract":"The Listen, Attend and Spell (LAS) model and other attention-based automatic speech recognition (ASR) models have known limitations when operated in a fully online mode. In this letter, we analyze the online operation of LAS models to demonstrate that these limitations stem from the handling of silence regions and the reliability of online attention mechanism at the edge of input buffers. We propose a novel and simple technique that can achieve...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/online-automatic-speech-recognition","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["speech recognition"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:kkbog8znn9t7v40ciyiidzn4","title":"Estimating Respiratory Rate From Breath Audio Obtained Through Wearable Microphones","url":"https://machinelearning.apple.com/research/estimating-respiratory-rate","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/estimating-respiratory-rate"],"alternate_titles":["Estimating Respiratory Rate From Breath Audio Obtained Through Wearable Microphones"],"published":"2021-08-06","authors":["Agni Kumar","Vikramjit Mitra","Carolyn Oliver","Adeeti Ullal","Matt Biddulph","Irida Mance"],"abstract":"Respiratory rate (RR) is a clinical metric used to assess overall health and physical fitness. An individual’s RR can change due to normal activities like physical exertion during exercise or due to chronic and acute illnesses. Remote estimation of RR offers a cost-effective method to track disease progression and cardio-respiratory fitness over time. This work investigates a model-driven approach to estimate RR from short audio segments obtained...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/estimating-respiratory-rate","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":[],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"}]}
