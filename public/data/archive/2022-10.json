{"papers":[{"id":"apple:g12qkcgq25ay6kmulpct8uml","title":"Prompting for a Conversation: How to Control a Dialog Model?","url":"https://machinelearning.apple.com/research/prompting-conversation","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/prompting-conversation"],"alternate_titles":["Prompting for a Conversation: How to Control a Dialog Model?"],"published":"2022-10-27","authors":["Josef Valvoda","Yimai Fang","David Vandyke"],"abstract":"Dialog modelling faces a difficult trade-off. Models are trained on a large amount of text, yet their responses need to be limited to a desired scope and style of a dialog agent. Because the datasets used to achieve the former contain language that is not compatible with the latter, pre-trained dialog models are fine-tuned on smaller curated datasets. However, the fine-tuning process robs them of the ability to produce diverse responses,...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/prompting-conversation","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["fine-tuning","prompting","agent"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:qlloc4tehmgc79p9e7gb9s63","title":"Non-Autoregressive Neural Machine Translation: A Call for Clarity","url":"https://machinelearning.apple.com/research/non-autoagressive-neural-machine","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/non-autoagressive-neural-machine"],"alternate_titles":["Non-Autoregressive Neural Machine Translation: A Call for Clarity"],"published":"2022-10-27","authors":["Robin M. Schmidt","Telmo Pires","Stephan Peitz","Jonas Lööf"],"abstract":"Non-autoregressive approaches aim to improve the inference speed of translation models by only requiring a single forward pass to generate the output sequence instead of iteratively producing each predicted token. Consequently, their translation quality still tends to be inferior to their autoregressive counterparts due to several issues involving output token interdependence. In this work, we take a step back and revisit several techniques that...","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/non-autoagressive-neural-machine","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":["neural","inference","token"],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://ma