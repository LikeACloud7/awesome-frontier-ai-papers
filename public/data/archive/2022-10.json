at the Workshop on Distribution-Free Uncertainty Quantification at ICML 2022.","companies":["Apple"],"matched_orgs":["Apple"],"company_groups":["company_us"],"company_regions":["US"],"sources":["official_publication_page"],"source":"official_publication_page","work_type":"publication","doi":"","openalex_id":"","cited_by_count":0,"quality_score":52,"matched_keywords":[],"author_affiliations":["Apple"],"concepts":[],"official_report":true,"quality_signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"},"evidence":[{"source":"official_publication_page","url":"https://machinelearning.apple.com/research/calibration-generalization-gap","labs":["Apple"],"signals":{"company_match_source":"official Apple Machine Learning page https://machinelearning.apple.com/research"}}],"topic_evidence":{"scope":"ai","classifier_version":2,"method":"official_ai_research_catalogue","ai_research_source":"https://machinelearning.apple.com/research","matched_terms":[],"concept_ids":[],"work_type":"publication"},"ai_research_source":"https://machinelearning.apple.com/research"},{"id":"apple:vwcpqrkg509un1j7j9d7j1nr","title":"SPIN: An Empirical Evaluation on Sharing Parameters of Isotropic Networks","url":"https://machinelearning.apple.com/research/isotropic-networks","paper_url":"","alternate_urls":["https://machinelearning.apple.com/research/isotropic-networks"],"alternate_titles":["SPIN: An Empirical Evaluation on Sharing Parameters of Isotropic Networks"],"published":"2022-10-17","authors":["Chien-Yu Lin","Anish Prabhu","Thomas Merth","Sachin Mehta","Anurag Ranjan","Maxwell Horton","Mohammad Rastegari"],"abstract":"Recent isotropic networks, such as ConvMixer and vision transformers, have found significant success across visual recognition tasks, matching or outperforming non-isotropic convolutional neural networks (CNNs). Isotropic architectures are particularly well-suited to cross-layer weight sharing, an effective neural network